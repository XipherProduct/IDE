    <div class="crumb">
      <span>alaska-monorepo</span>
      <span class="sep">›</span>
      <span>src</span>
      <span class="sep">›</span>
      <span>warehouse</span>
      <span class="sep">›</span>
      <b>moveItem.ts</b>
      <span class="sep">›</span>
      <span>function <span style="color:var(--ice)">moveItem</span></span>
    </div>
    <div class="branch">⌥ main · ↑2 ↓0</div>
  </div>

  <!-- ============ FRAME ============ -->
  <div class="frame">

    <!-- ===== ACTIVITY ===== -->
