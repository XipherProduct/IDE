    <span class="item">LF</span>
    <span class="item">TypeScript 5.6</span>
    <span class="item">Ln 21, Col 24</span>
    <span class="item ice">5.5 · high</span>
    <span class="item">токены <span class="num" id="tok">1 248</span> / 8 000</span>
    <span class="item" id="clock">14:23:12</span>
  </footer>

</main>

<script>
/* ============================================================
   IDE.html — composer interactions + looping AI demo
============================================================ */
(() => {
  const CODE = document.getElementById('code');
  const CONVO = document.getElementById('convo');
  const KLOG = document.getElementById('klog');
  const TOK = document.getElementById('tok');
  const CLOCK = document.getElementById('clock');
  const PROF = document.getElementById('profile-indicator');

  /* === BASE CODE ============================================ */
  const BASE = [
    { n: 14, html: '<span class="kw">import</span> { <span class="ty">ItemId</span>, <span class="ty">BinId</span> } <span class="kw">from</span> <span class="str">"./types"</span>' },
    { n: 15, html: '<span class="kw">import</span> { <span class="fn">findItem</span> } <span class="kw">from</span> <span class="str">"./locks"</span>' },
    { n: 16, html: '<span class="kw">import</span> { <span class="ty">NotFound</span>, <span class="ty">Conflict</span> } <span class="kw">from</span> <span class="str">"./errors"</span>' },
    { n: 17, html: '' },
    { n: 18, html: '<span class="com">/** Перенести позицию в другую ячейку склада. */</span>' },
    { n: 19, html: '<span class="kw">export function</span> <span class="fn">moveItem</span>(<span class="var">id</span>: <span class="ty">ItemId</span>, <span class="var">to</span>: <span class="ty">BinId</span>) {' },
    { n: 20, html: '  <span class="kw">const</span> <span class="var">item</span> = <span class="fn">findItem</span>(<span class="var">id</span>)' },
    { n: 21, html: '  <span class="kw">if</span> (!<span class="var">item</span>) <span class="kw">throw new</span> <span class="ty">NotFound</span>(<span class="str">"item missing"</span>)' },
    { n: 22, html: '  <span class="var">item</span>.<span class="var">bin</span> = <span class="var">to</span>' },
    { n: 23, html: '  <span class="var">item</span>.<span class="var">movedAt</span> = <span class="ty">Date</span>.<span class="fn">now</span>()' },
    { n: 24, html: '  <span class="kw">return</span> <span class="var">item</span>' },
    { n: 25, html: '}' },
    { n: 26, html: '' },
    { n: 27, html: '<span class="com">// TODO: уважать item.locked перед перемещением</span>' }
  ];
  const GHOST = '<span class="kw">if</span> (<span class="var">item</span>.<span class="var">locked</span>) <span class="kw">throw new</span> <span class="ty">Conflict</span>(<span class="str">"item is locked"</span>, { <span class="var">by</span>: <span class="var">item</span>.<span class="var">lockedBy</span> })';

  function renderBase(){
    CODE.innerHTML = BASE.map((l, i) => {
      const cur = i === 6 ? ' cur' : '';
      return `<div class="line${cur}" data-idx="${i}"><span class="gut">${l.n}</span><span>${l.html}</span></div>`;
    }).join('');
  }

  /* === CHAT BUBBLE =========================================== */
  function aurMark(){
    return `<span class="aurora-mark"><svg viewBox="0 0 30 18">
      <path class="w w1" d="M0,9 Q7.5,3 15,9 T30,9"><animate attributeName="d" dur="3s" repeatCount="indefinite" values="M0,9 Q7.5,3 15,9 T30,9;M0,9 Q7.5,15 15,9 T30,9;M0,9 Q7.5,3 15,9 T30,9"/></path>
      <path class="w w2" d="M0,9 Q7.5,5 15,9 T30,9"><animate attributeName="d" dur="3.5s" repeatCount="indefinite" values="M0,9 Q7.5,13 15,9 T30,9;M0,9 Q7.5,5 15,9 T30,9;M0,9 Q7.5,13 15,9 T30,9"/></path>
    </svg></span>`;
  }
  function bubble(role, who){
    const wrap = document.createElement('div');
    wrap.className = 'msg ' + role;
    const avatar = role === 'ai' ? `<span class="avatar">${aurMark()}</span>` : `<span class="avatar">Я</span>`;
    wrap.innerHTML = `${avatar}<div><div class="meta"><b>${who}</b> · ${hhmm()}</div><div class="body"></div></div>`;
    CONVO.appendChild(wrap);
    return wrap.querySelector('.body');
  }
  function hhmm(){
    const d = new Date(); return `${pad(d.getHours())}:${pad(d.getMinutes())}`;
  }
  function pad(n){ return String(n).padStart(2,'0') }

  function typeInto(el, html, speed = 14){
    return new Promise(resolve => {
      const tmp = document.createElement('div');
      tmp.innerHTML = html;
      const nodes = Array.from(tmp.childNodes);
      el.innerHTML = '';
      const caret = document.createElement('span');
      caret.className = 'caret';
      el.appendChild(caret);
      let i = 0;
      function step(){
        if (i >= nodes.length){ caret.remove(); resolve(); return; }
        const node = nodes[i++];
        if (node.nodeType === 3){
          const text = node.textContent;
          let j = 0;
          (function tick(){
            if (j >= text.length){ step(); return; }
            caret.before(document.createTextNode(text[j++]));
            CONVO.scrollTop = CONVO.scrollHeight;
            setTimeout(tick, speed);
          })();
        } else {
          caret.before(node.cloneNode(true));
          setTimeout(step, 30);
        }
      }
      step();
    });
  }

  /* === KLOG ================================================== */
  function klog(msg, cls = ''){
    const t = new Date();
    const ts = `<span class="ts">${pad(t.getHours())}:${pad(t.getMinutes())}:${pad(t.getSeconds())}</span>`;
    const div = document.createElement('div');
    if (cls) div.classList.add(cls);
    div.innerHTML = `${ts} ${msg}`;
    KLOG.appendChild(div);
    KLOG.scrollTop = KLOG.scrollHeight;
  }
  function sleep(ms){ return new Promise(r => setTimeout(r, ms)) }
  function setTokens(v){ TOK.textContent = v.toLocaleString('ru-RU').replace(/,/g, ' ') }
  function readFile(id){
    const li = document.querySelector(`.tree li[data-file="${id}"]`);
    if (!li) return Promise.resolve();
    li.classList.add('reading');
    return sleep(1000).then(() => {
      li.classList.remove('reading');
      klog(`agent · прочитан <b style="color:var(--ink-2)">${id}.ts</b>`, 'ok');
    });
  }

  /* === MENU TOGGLES ========================================= */
  function setupMenus(){
    const buttons = document.querySelectorAll('.cbtn');
    buttons.forEach(btn => {
      const menu = btn.querySelector('.menu');
      if (!menu) return;
      btn.addEventListener('click', e => {
        e.stopPropagation();
        document.querySelectorAll('.cbtn.open').forEach(b => { if (b !== btn) b.classList.remove('open') });
        btn.classList.toggle('open');
      });
      menu.addEventListener('click', e => e.stopPropagation());
      menu.querySelectorAll('.mi').forEach(mi => {
        mi.addEventListener('click', () => {
          if (mi.dataset.model || mi.dataset.perm || mi.dataset.effort){
            menu.querySelectorAll('.mi.on').forEach(m => m.classList.remove('on'));
            mi.classList.add('on');
            // update button label
            const labelSpan = btn.querySelector(':scope > span:not(.glyph):not(.ice):not(small)');
            if (labelSpan){
              const txt = mi.querySelector('span:not(.glyph):not(.meta)').firstChild.textContent.trim();
              if (mi.dataset.model){
                const map = { mini: '5.4 mini', std: '5.4', flag: '5.5', qwen: 'qwen' };
                labelSpan.textContent = map[mi.dataset.model] || txt;
              } else if (mi.dataset.perm){
                const map = { ask: 'Ask', auto: 'Auto', read: 'Read', plan: 'Plan' };
                labelSpan.textContent = map[mi.dataset.perm] || txt;
              } else if (mi.dataset.effort){
                const map = { low: 'low', med: 'medium', high: 'high', xhigh: 'x-high' };
                labelSpan.textContent = map[mi.dataset.effort] || txt;
              }
            }
          }
          if (mi.dataset.attach){
            addChip(mi.dataset.attach);
          }
          btn.classList.remove('open');
        });
      });
    });

    document.addEventListener('click', () => {
      document.querySelectorAll('.cbtn.open').forEach(b => b.classList.remove('open'));
    });

    // active toggle
    const btnActive = document.getElementById('btn-active');
    btnActive.addEventListener('click', e => {
      e.stopPropagation();
      btnActive.classList.toggle('on');
    });

    // send
    document.getElementById('btn-send').addEventListener('click', e => {
      e.stopPropagation();
      // visual nudge — no real send
      const btn = e.currentTarget;
      btn.style.transform = 'scale(.96)';
      setTimeout(() => btn.style.transform = '', 150);
    });

    // chip remove
    document.getElementById('chips').addEventListener('click', e => {
      if (e.target.classList.contains('x')) e.target.parentElement.remove();
    });
  }

  function addChip(kind){
    const map = {
      file:   { icon: '‹›', cls: 'ice', label: 'config.json' },
      folder: { icon: '▣', cls: 'ice', label: 'src/db/' },
      url:    { icon: '@',  cls: 'aur', label: 'docs.openai.com/...' },
      image:  { icon: '▤',  cls: 'aur', label: 'screenshot.png' },
      git:    { icon: '⌥',  cls: 'ice', label: 'diff: main..HEAD · 12 files' }
    };
    const c = map[kind] || map.file;
    const chip = document.createElement('span');
    chip.className = 'chip';
    chip.innerHTML = `<span class="${c.cls}">${c.icon}</span> ${c.label} <span class="x">×</span>`;
    document.getElementById('chips').appendChild(chip);
  }

  /* === LOOP ================================================= */
  async function loop(){
    while (true){
      renderBase();
      CONVO.innerHTML = '';
      KLOG.innerHTML = '';
      klog('indexer · обновил граф зависимостей');
      klog('lsp · 0 ошибок · 0 предупреждений');
      klog('watcher · 1 247 файлов');
      setTokens(1248);
      PROF.style.top = '20%';
      await sleep(1200);

      // user msg
      const u = bubble('user', 'вы');
      await typeInto(u, 'проверь блокировку перед перемещением. если <code>item.locked</code> — кинь <code>Conflict</code>.', 22);
      await sleep(300);

      // AI tool steps
      const a = bubble('ai', 'alaska');
      a.innerHTML = `
        <div class="tools">
          <div class="step run" data-s="0"><span class="glyph"></span>читаю moveItem.ts</div>
          <div class="step queue" data-s="1"><span class="glyph"></span>читаю types.ts</div>
          <div class="step queue" data-s="2"><span class="glyph"></span>читаю locks.ts</div>
          <div class="step queue" data-s="3"><span class="glyph"></span>ищу вызовы</div>
        </div>
      `;
      CONVO.scrollTop = CONVO.scrollHeight;
      await sleep(550);
      a.querySelector('[data-s="0"]').className = 'step done';
      klog('agent · прочитан <b style="color:var(--ink-2)">moveItem.ts</b>', 'ok');
      setTokens(1612);

      a.querySelector('[data-s="1"]').className = 'step run';
      await readFile('types');
      a.querySelector('[data-s="1"]').className = 'step done';
      setTokens(1860);

      a.querySelector('[data-s="2"]').className = 'step run';
      await readFile('locks');
      a.querySelector('[data-s="2"]').className = 'step done';
      setTokens(2102);

      a.querySelector('[data-s="3"]').className = 'step run';
      await sleep(800);
      klog('grep · 12 вхождений moveItem в 4 файлах', 'ok');
      a.querySelector('[data-s="3"]').className = 'step done';

      const m = document.createElement('div');
      m.style.marginTop = '8px';
      a.appendChild(m);
      await typeInto(m, 'Добавил guard на <code>item.locked</code> сразу после <code>findItem</code>. Использовал существующий <code>Conflict</code> из <code>errors.ts</code>. <b style="color:var(--aurora)">+1 строка @ moveItem.ts:22</b>', 18);
      setTokens(2890);

      // ghost line
      const target = CODE.querySelector('[data-idx="7"]');
      const gline = document.createElement('div');
      gline.className = 'line ghost';
      gline.innerHTML = `<span class="gut">22</span><span>  ${GHOST}</span>`;
      target.before(gline);
      klog('agent · предложен патч @ moveItem.ts:22', 'ok');
      PROF.style.top = '35%';
      await sleep(120);
      gline.classList.add('show');

      // tab hint
      const hint = document.createElement('div');
      hint.style.cssText = `position:absolute; right:14px; bottom:170px; font-family:"JetBrains Mono",monospace; font-size:11px; background:var(--bg-2); border:1px solid var(--line-2); padding:6px 10px; border-radius:6px; color:var(--ink-2); opacity:0; transform:translateY(6px); transition:opacity .25s, transform .25s; z-index:5; pointer-events:none;`;
      hint.innerHTML = '<span style="color:var(--ice)">⇥ Tab</span> применить · Esc отменить';
      document.querySelector('.editor').appendChild(hint);
      requestAnimationFrame(() => { hint.style.opacity = '1'; hint.style.transform = 'translateY(0)' });
      await sleep(900);
      hint.style.opacity = '0';
      setTimeout(() => hint.remove(), 300);

      // commit
      gline.classList.add('committing');
      klog('agent · применил патч · <b style="color:var(--aurora)">+1 строка</b>', 'ok');
      await sleep(700);
      gline.classList.remove('committing');
      gline.classList.add('committed');

      // remove TODO line
      const lines = CODE.querySelectorAll('.line');
      const todo = lines[lines.length - 1];
      todo.classList.add('hl-old');
      await sleep(600);
      todo.classList.add('removing');
      klog('agent · TODO разрешён → удалил строку', 'ok');
      setTokens(3104);

      await sleep(3000);
      document.querySelector('.frame').style.transition = 'opacity .5s ease';
      document.querySelector('.frame').style.opacity = '.55';
      await sleep(600);
      document.querySelector('.frame').style.opacity = '1';
    }
  }

  /* === CLOCK ================================================ */
  function tick(){
    const d = new Date();
    if (CLOCK) CLOCK.textContent = `${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;
  }
  tick();
  setInterval(tick, 1000);

  /* === USER MENU + SIGN OUT ================================ */
  function setupUserMenu(){
    const trigger = document.getElementById('user-trigger');
    const menu = document.getElementById('user-menu');
    if (!trigger || !menu) return;
    trigger.addEventListener('click', e => {
      e.stopPropagation();
      const open = menu.classList.toggle('show');
      trigger.classList.toggle('open', open);
    });
    document.addEventListener('click', e => {
      if (!menu.contains(e.target) && !trigger.contains(e.target)){
        menu.classList.remove('show');
        trigger.classList.remove('open');
      }
    });
    menu.querySelectorAll('.um-item').forEach(item => {
      item.addEventListener('click', e => {
        e.preventDefault();
        if (item.id === 'um-signout'){
          doSignOut();
        }
        menu.classList.remove('show');
        trigger.classList.remove('open');
      });
    });
  }

  function doSignOut(){
    const ide = document.querySelector('.ide');
    ide.style.transition = 'opacity .4s ease, filter .4s ease';
    ide.style.opacity = '.18';
    ide.style.filter = 'blur(3px) saturate(.4)';

    const t = document.createElement('div');
    t.className = 'signout-toast';
    t.innerHTML = `
      <div class="title">✓ выход из аккаунта</div>
      <div class="sub">refresh-токены семейства отозваны · 1 устройство</div>
    `;
    document.body.appendChild(t);
    requestAnimationFrame(() => t.classList.add('show'));
    setTimeout(() => {
      t.classList.remove('show');
      setTimeout(() => {
        t.remove();
        ide.style.opacity = '1';
        ide.style.filter = 'none';
      }, 300);
    }, 2400);
  }

  /* === TOP MENUS ============================================ */
  function setupTopMenus(){
    const tabs = document.querySelectorAll('.top-tab[data-menu]');
    let anyOpen = false;
    tabs.forEach(tab => {
      tab.addEventListener('click', e => {
        e.stopPropagation();
        const isOpen = tab.classList.contains('open');
        tabs.forEach(t => t.classList.remove('open'));
        if (!isOpen){ tab.classList.add('open'); anyOpen = true }
        else anyOpen = false;
      });
      tab.addEventListener('mouseenter', () => {
        if (anyOpen){
          tabs.forEach(t => t.classList.remove('open'));
          tab.classList.add('open');
        }
      });
    });
    document.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('open'));
      anyOpen = false;
    });
    document.querySelectorAll('.menu-dd .mdd-item[data-act]').forEach(item => {
      item.addEventListener('click', e => {
        e.stopPropagation();
        const act = item.dataset.act;
        tabs.forEach(t => t.classList.remove('open'));
        anyOpen = false;
        if (act === 'signout' && typeof doSignOut === 'function') doSignOut();
        if (act === 'go-search'){
          const btn = document.querySelector('.activity .act[data-panel="search"]');
          if (btn) btn.click();
        }
      });
    });
  }

  /* === ACTIVITY PANEL SWITCH ================================ */
  function setupActivity(){
    const buttons = document.querySelectorAll('.activity .act[data-panel]');
    const panels = document.querySelectorAll('.explorer .panel');
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const target = btn.dataset.panel;
        buttons.forEach(b => b.classList.toggle('active', b === btn));
        panels.forEach(p => p.classList.toggle('active', p.dataset.panel === target));
      });
    });
  }

  /* === GO =================================================== */
  renderBase();
  setupMenus();
  setupUserMenu();
  setupTopMenus();
  setupActivity();
  loop();
})();
</script>

</body>
</html>
