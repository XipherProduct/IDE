<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>ALaska · IDE</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Onest:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
<style>
  :root{
    --bg:        #06080c;
    --bg-2:      #0a0d13;
    --panel:     #0e131b;
    --panel-2:   #131a24;
    --line:      #1b2330;
    --line-2:    #28323f;
    --ink:       #ece5d3;
    --ink-2:     #a8a193;
    --mute:      #6f6a5e;
    --ice:       oklch(0.83 0.10 220);
    --ice-2:     oklch(0.62 0.13 235);
    --aurora:    oklch(0.78 0.16 155);
    --aurora-2:  oklch(0.72 0.14 195);
    --magenta:   oklch(0.72 0.18 330);
    --warn:      oklch(0.78 0.13 80);
    --red:       oklch(0.70 0.18 25);
  }
  *{ box-sizing: border-box }
  html, body{
    margin: 0; padding: 0; height: 100%;
    background: var(--bg);
    color: var(--ink);
    font-family: "Onest", system-ui, sans-serif;
    overflow: hidden;
  }
  ::selection{ background: oklch(0.83 0.10 220 / .25); color: #fff }
  button{ background: transparent; border: none; cursor: pointer; color: inherit; font-family: inherit }

  /* === BACKGROUND ============================================ */
  .bg-topo{
    position: fixed; inset: 0; z-index: 0; pointer-events: none;
  }
  .bg-topo svg{ width: 200%; height: 200%; opacity: .12;
    animation: topo-drift 240s linear infinite }
  @keyframes topo-drift{
    0%   { transform: translate(0,0) }
    100% { transform: translate(-50%, -25%) }
  }
  .bg-aurora{
    position: fixed; inset: 0; z-index: 0; pointer-events: none;
    overflow: hidden;
    opacity: .28;
  }
  .bg-aurora svg{ width: 110%; height: 75% }
  .bg-noise{
    position: fixed; inset: 0; z-index: 1; pointer-events: none;
    background-image: radial-gradient(rgba(255,255,255,.022) 1px, transparent 1px);
    background-size: 3px 3px;
    opacity: .35;
    mix-blend-mode: overlay;
  }

  /* === SHELL ================================================= */
  .ide{
    position: fixed; inset: 0;
    z-index: 2;
    display: grid;
    grid-template-rows: 42px 30px 1fr 24px;
    background: var(--panel);
    border: 1px solid var(--line-2);
    margin: 14px;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 24px 60px -20px rgba(0,0,0,.65);
  }

  /* === TOPBAR ================================================ */
  .topbar{
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 0 14px;
    background: linear-gradient(180deg, var(--bg-2) 0%, var(--panel) 100%);
    border-bottom: 1px solid var(--line);
  }
  .logo{
    display: flex; align-items: center; gap: 9px;
    font-size: 13.5px;
    font-weight: 500;
    letter-spacing: -0.005em;
  }
  .logo .mark{ width: 22px; height: 22px; flex-shrink: 0 }
  .logo .mark svg{ width: 100%; height: 100% }
  .logo b{ font-weight: 600 }
  .logo .dot{ color: var(--ice) }

  .topbar-center{
    display: flex; justify-content: center;
    gap: 2px;
  }
  .top-tab{
    position: relative;
    padding: 4px 12px;
    border-radius: 5px;
    font-size: 12px;
    color: var(--ink-2);
    background: transparent;
    border: none;
    font-family: inherit;
    cursor: pointer;
    transition: background .12s ease, color .12s ease;
  }
  .top-tab:hover{ background: var(--bg-2); color: var(--ink) }
  .top-tab.open{ background: var(--panel-2); color: var(--ink); box-shadow: 0 0 0 1px var(--line-2) inset }

  .menu-dd{
    position: absolute;
    top: calc(100% + 6px); left: 0;
    min-width: 240px;
    background: var(--panel);
    border: 1px solid var(--line-2);
    border-radius: 9px;
    box-shadow: 0 24px 60px -14px rgba(0,0,0,.7);
    padding: 4px;
    z-index: 60;
    opacity: 0;
    transform: translateY(-4px);
    pointer-events: none;
    transition: opacity .15s ease, transform .15s ease;
    text-align: left;
  }
  .top-tab.open .menu-dd{ opacity: 1; transform: translateY(0); pointer-events: auto }
  .mdd-item{
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 14px;
    padding: 7px 10px;
    border-radius: 5px;
    font-size: 12px;
    color: var(--ink-2);
    cursor: pointer;
    align-items: center;
    transition: background .12s ease, color .12s ease;
  }
  .mdd-item:hover{ background: var(--panel-2); color: var(--ink) }
  .mdd-item .kbd{
    color: var(--mute);
    font-family: "JetBrains Mono", monospace;
    font-size: 10.5px;
  }
  .mdd-item .mdd-arrow{ color: var(--mute); font-size: 11px }
  .mdd-sep{ height: 1px; background: var(--line); margin: 4px 6px }
  .mdd-item.danger{ color: var(--red) }
  .mdd-item.danger:hover{ background: oklch(0.70 0.18 25 / .10); color: var(--red) }

  /* activity panels */
  .explorer{ position: relative }
  .panel{ display: none; flex-direction: column; height: 100%; min-height: 0; flex: 1 }
  .panel.active{ display: flex }

  .search-input{
    display: flex; gap: 6px; align-items: center;
    background: var(--panel-2);
    border: 1px solid var(--line-2);
    border-radius: 6px;
    padding: 6px 8px;
    margin: 10px 14px 6px;
  }
  .search-input:focus-within{ border-color: var(--ice) }
  .search-input svg{ width: 13px; height: 13px; color: var(--mute) }
  .search-input input{
    flex: 1; min-width: 0;
    background: transparent; border: none; outline: none;
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    color: var(--ink);
  }
  .search-input input::placeholder{ color: var(--mute) }
  .search-input .x{ color: var(--mute); cursor: pointer; padding: 0 4px }
  .search-input .x:hover{ color: var(--ink) }
  .search-filters{
    display: flex; gap: 4px; padding: 0 14px 8px;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--line);
  }
  .search-filter{
    padding: 3px 7px;
    border: 1px solid var(--line-2);
    border-radius: 4px;
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    color: var(--mute);
    background: transparent;
    cursor: pointer;
  }
  .search-filter.on{
    background: oklch(0.83 0.10 220 / .12);
    border-color: oklch(0.83 0.10 220 / .35);
    color: var(--ice);
  }
  .search-results{ flex: 1; overflow-y: auto; padding: 4px 0; font-family: "JetBrains Mono", monospace }
  .search-results::-webkit-scrollbar{ width: 4px }
  .search-results::-webkit-scrollbar-thumb{ background: var(--line-2) }
  .search-rf{
    padding: 6px 14px 4px;
    font-size: 11px;
    color: var(--ink-2);
    display: flex; justify-content: space-between;
    cursor: default;
  }
  .search-rf:hover{ background: var(--panel-2) }
  .search-rf .count{
    color: var(--ice);
    font-size: 10px;
    background: var(--bg-2);
    padding: 1px 6px;
    border-radius: 8px;
  }
  .search-rl{
    padding: 3px 14px 3px 32px;
    font-size: 11px;
    color: var(--mute);
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 8px;
    cursor: default;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .search-rl:hover{ background: var(--panel-2); color: var(--ink-2) }
  .search-rl mark{
    background: oklch(0.78 0.16 155 / .25);
    color: var(--aurora);
    font-weight: 500;
    padding: 0 2px;
    border-radius: 2px;
  }

  .scm-head{
    padding: 10px 14px;
    border-bottom: 1px solid var(--line);
    display: flex; justify-content: space-between; align-items: center;
    font-family: "JetBrains Mono", monospace;
    font-size: 10.5px;
    color: var(--mute);
    text-transform: uppercase;
    letter-spacing: .12em;
  }
  .scm-head .ico{ display: inline-flex; gap: 6px }
  .scm-head .ico svg{ width: 13px; height: 13px; color: var(--mute); cursor: pointer }
  .scm-head .ico svg:hover{ color: var(--ice) }
  .scm-commit{
    padding: 10px 14px;
    border-bottom: 1px solid var(--line);
    background: var(--bg-2);
  }
  .scm-commit textarea{
    width: 100%;
    background: var(--panel);
    border: 1px solid var(--line-2);
    border-radius: 6px;
    padding: 8px 10px;
    font-family: "JetBrains Mono", monospace;
    font-size: 11.5px;
    color: var(--ink);
    outline: none;
    resize: none;
    min-height: 50px;
    line-height: 1.45;
  }
  .scm-commit textarea:focus{ border-color: var(--ice) }
  .scm-commit .row{ display: flex; gap: 6px; margin-top: 8px; align-items: center }
  .scm-btn{
    display: inline-flex; align-items: center; gap: 6px;
    padding: 5px 10px;
    background: var(--ice);
    color: #06121d;
    border: none;
    border-radius: 5px;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    font-weight: 600;
    cursor: pointer;
    transition: background .12s, transform .1s;
  }
  .scm-btn:hover{ background: #fff }
  .scm-btn:active{ transform: scale(.97) }
  .scm-btn.ghost{
    background: transparent;
    color: var(--ink-2);
    border: 1px solid var(--line-2);
  }
  .scm-btn.ghost:hover{ background: var(--panel-2); color: var(--ink); border-color: var(--ice) }
  .scm-meta{
    margin-left: auto;
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    color: var(--mute);
  }
  .scm-list{ flex: 1; overflow-y: auto; padding: 4px 0 }
  .scm-list::-webkit-scrollbar{ width: 4px }
  .scm-list::-webkit-scrollbar-thumb{ background: var(--line-2) }
  .scm-group{
    padding: 10px 14px 4px;
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    color: var(--mute);
    text-transform: uppercase;
    letter-spacing: .12em;
    display: flex; justify-content: space-between;
  }
  .scm-group .count{ color: var(--ink-2); letter-spacing: 0; text-transform: none }
  .scm-row{
    display: grid;
    grid-template-columns: 14px 1fr auto;
    gap: 8px;
    padding: 4px 14px;
    font-family: "JetBrains Mono", monospace;
    font-size: 11.5px;
    color: var(--ink-2);
    cursor: default;
    align-items: center;
  }
  .scm-row:hover{ background: var(--panel-2); color: var(--ink) }
  .scm-row .badge{ font-size: 10px; font-weight: 600; text-align: center; width: 14px }
  .scm-row .badge.M{ color: var(--warn) }
  .scm-row .badge.A{ color: var(--aurora) }
  .scm-row .badge.D{ color: var(--red) }
  .scm-row .badge.U{ color: var(--magenta) }
  .scm-row .path{ overflow: hidden; text-overflow: ellipsis; white-space: nowrap }
  .scm-row .actions{ display: flex; gap: 2px; opacity: 0; transition: opacity .12s }
  .scm-row:hover .actions{ opacity: 1 }
  .scm-row .actions span{
    color: var(--mute);
    font-size: 11px;
    cursor: pointer;
    padding: 0 4px;
    border-radius: 3px;
  }
  .scm-row .actions span:hover{ background: var(--bg-2); color: var(--ink) }

  .panel-empty{
    flex: 1;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    padding: 30px 22px;
    text-align: center;
    color: var(--ink-2);
    font-size: 12.5px;
    line-height: 1.6;
  }
  .panel-empty .ico{ color: var(--mute); margin-bottom: 14px; opacity: .6 }
  .panel-empty .ico svg{ width: 28px; height: 28px }
  .panel-empty .meta{
    font-family: "JetBrains Mono", monospace;
    font-size: 10.5px;
    color: var(--mute);
    margin-top: 8px;
    letter-spacing: .04em;
  }
  .panel-empty .meta b{ color: var(--ice); font-weight: 500 }

  .act{ position: relative }
  .act .badge{
    position: absolute;
    top: 3px; right: 3px;
    min-width: 14px; height: 14px;
    background: var(--aurora);
    border-radius: 7px;
    color: #04241a;
    font-family: "JetBrains Mono", monospace;
    font-size: 9.5px; font-weight: 700;
    display: grid; place-items: center;
    padding: 0 4px;
    pointer-events: none;
  }

  .user{ display: flex; gap: 10px; align-items: center; min-width: 0; position: relative }
  .user .email{
    font-family: "JetBrains Mono", monospace;
    font-size: 11.5px;
    color: var(--ink-2);
    max-width: 180px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .user .avatar{
    width: 26px; height: 26px;
    border-radius: 50%;
    background: oklch(0.83 0.10 220 / .15);
    border: 1px solid var(--line-2);
    color: var(--ice);
    display: grid; place-items: center;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    font-weight: 600;
    flex-shrink: 0;
  }
  .user .quota{
    display: inline-flex; align-items: center; gap: 6px;
    font-family: "JetBrains Mono", monospace;
    font-size: 10.5px;
    color: var(--mute);
    text-transform: uppercase;
    letter-spacing: .08em;
    padding: 4px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg-2);
    flex-shrink: 0;
  }
  .user .quota b{ color: var(--ice); font-weight: 600; letter-spacing: 0 }
  .user .quota .dot-aur{
    width: 5px; height: 5px; border-radius: 50%;
    background: var(--aurora);
    box-shadow: 0 0 6px var(--aurora);
  }

  /* === USER TRIGGER + DROPDOWN ============================== */
  .user-trigger{
    display: flex; align-items: center;
    gap: 10px;
    padding: 3px 4px 3px 10px;
    border-radius: 999px;
    background: transparent;
    border: 1px solid transparent;
    transition: background .15s ease, border-color .15s ease;
    min-width: 0;
  }
  .user-trigger:hover, .user-trigger.open{
    background: var(--bg-2);
    border-color: var(--line);
  }
  .user-trigger .caret{
    color: var(--mute);
    font-size: 10px;
    margin-left: 2px;
    transition: transform .15s ease;
  }
  .user-trigger.open .caret{ transform: rotate(180deg) }

  .user-menu{
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    width: 296px;
    background: var(--panel);
    border: 1px solid var(--line-2);
    border-radius: 12px;
    box-shadow: 0 30px 70px -15px rgba(0,0,0,.75), 0 0 0 1px rgba(125,211,252,.05);
    z-index: 60;
    overflow: hidden;
    opacity: 0;
    transform: translateY(-6px);
    pointer-events: none;
    transition: opacity .18s ease, transform .18s ease;
  }
  .user-menu.show{ opacity: 1; transform: translateY(0); pointer-events: auto }
  .um-header{
    display: flex; gap: 12px; align-items: center;
    padding: 14px 16px 12px;
    border-bottom: 1px solid var(--line);
  }
  .um-avatar{
    width: 38px; height: 38px;
    border-radius: 50%;
    background: linear-gradient(135deg, oklch(0.83 0.10 220 / .25), oklch(0.78 0.16 155 / .15));
    border: 1px solid var(--line-2);
    color: var(--ice);
    display: grid; place-items: center;
    font-family: "JetBrains Mono", monospace;
    font-size: 15px; font-weight: 600;
    flex-shrink: 0;
  }
  .um-id{ min-width: 0 }
  .um-name{ font-size: 13.5px; color: var(--ink); font-weight: 500; letter-spacing: -0.005em }
  .um-email{
    font-family: "JetBrains Mono", monospace;
    font-size: 11px; color: var(--mute);
    margin-top: 2px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .um-plan{
    padding: 12px 16px 10px;
    border-bottom: 1px solid var(--line);
    background: var(--bg-2);
  }
  .um-row{
    display: flex; justify-content: space-between; align-items: baseline;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    color: var(--mute);
    padding: 3px 0;
  }
  .um-row b{ color: var(--ink); font-weight: 500 }
  .um-row .ice{ color: var(--ice); font-weight: 600 }
  .um-row.sub{ color: var(--mute); opacity: .75 }
  .um-bar{
    height: 4px;
    background: rgba(255,255,255,.04);
    border-radius: 2px;
    overflow: hidden;
    margin: 6px 0 4px;
  }
  .um-bar i{
    display: block; height: 100%; width: 0;
    background: linear-gradient(90deg, var(--ice), var(--aurora));
    border-radius: 2px;
    transition: width .8s cubic-bezier(.2,.7,.2,1);
  }
  .um-section{ padding: 4px 0; border-bottom: 1px solid var(--line) }
  .um-section:last-of-type{ border-bottom: none }
  .um-item{
    display: grid;
    grid-template-columns: 20px 1fr auto;
    gap: 10px;
    align-items: center;
    padding: 8px 16px;
    font-size: 12.5px;
    color: var(--ink-2);
    text-decoration: none;
    cursor: pointer;
    transition: background .12s ease, color .12s ease;
  }
  .um-item:hover{ background: var(--panel-2); color: var(--ink) }
  .um-item .glyph{
    color: var(--mute);
    font-family: "JetBrains Mono", monospace;
    font-size: 13px;
    text-align: center;
  }
  .um-item .meta{
    color: var(--mute);
    font-family: "JetBrains Mono", monospace;
    font-size: 10.5px;
  }
  .um-item .ext{
    color: var(--ice);
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
  }
  .um-item.danger{ color: var(--red) }
  .um-item.danger:hover{ background: oklch(0.70 0.18 25 / .10); color: var(--red) }
  .um-item.danger .glyph{ color: var(--red) }
  .um-foot{
    padding: 8px 16px;
    background: var(--bg-2);
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    color: var(--mute);
    text-align: center;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  /* === SIGN-OUT TOAST ======================================= */
  .signout-toast{
    position: fixed;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%) scale(.96);
    background: var(--panel);
    border: 1px solid var(--ice);
    border-radius: 12px;
    padding: 22px 30px;
    z-index: 100;
    box-shadow: 0 40px 80px -10px rgba(0,0,0,.8), 0 0 60px -10px rgba(125,211,252,.3);
    text-align: center;
    font-family: "JetBrains Mono", monospace;
    font-size: 12.5px;
    color: var(--ink);
    opacity: 0;
    transition: opacity .25s ease, transform .25s ease;
  }
  .signout-toast.show{ opacity: 1; transform: translate(-50%, -50%) scale(1) }
  .signout-toast .title{ color: var(--aurora); margin-bottom: 6px; font-size: 13px }
  .signout-toast .sub{ color: var(--mute); font-size: 11px; letter-spacing: .04em }

  /* === CRUMB ROW ============================================= */
  .crumb-row{
    display: flex; align-items: center;
    padding: 0 14px;
    background: var(--bg-2);
    border-bottom: 1px solid var(--line);
    gap: 14px;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    color: var(--mute);
  }
  .crumb-row .crumb{ display: flex; align-items: center; gap: 6px }
  .crumb-row .crumb b{ color: var(--ink); font-weight: 500 }
  .crumb-row .crumb .sep{ opacity: .35 }
  .crumb-row .branch{
    margin-left: auto;
    padding: 3px 9px;
    border: 1px solid var(--line-2);
    border-radius: 4px;
    color: var(--ink-2);
  }

  /* === MAIN FRAME — 5 columns =============================== */
  .frame{
    display: grid;
    grid-template-columns: 44px 240px 1fr 400px 200px;
    min-height: 0;
    overflow: hidden;
  }

  /* === ACTIVITY BAR ========================================== */
  .activity{
    background: var(--bg-2);
    border-right: 1px solid var(--line);
    display: flex; flex-direction: column;
    align-items: center;
    padding: 8px 0;
    gap: 4px;
  }
  .act{
    width: 32px; height: 32px;
    display: grid; place-items: center;
    color: var(--mute);
    border-radius: 6px;
    position: relative;
    transition: color .15s ease, background .15s ease;
  }
  .act:hover{ color: var(--ink-2); background: var(--panel-2) }
  .act.active{ color: var(--ink); background: var(--panel-2) }
  .act.active::before{
    content: ""; position: absolute;
    left: -8px; top: 6px; bottom: 6px;
    width: 2px; background: var(--ice);
    border-radius: 2px;
  }
  .act svg{ width: 18px; height: 18px }
  .act.compass svg{ width: 24px; height: 24px }
  .act-spacer{ flex: 1 }

  /* === EXPLORER (file tree) ================================= */
  .explorer{
    background: var(--bg-2);
    border-right: 1px solid var(--line);
    display: flex; flex-direction: column;
    min-height: 0;
  }
  .explorer .head{
    display: flex; justify-content: space-between; align-items: center;
    padding: 10px 14px;
    font-family: "JetBrains Mono", monospace;
    font-size: 10.5px;
    color: var(--mute);
    text-transform: uppercase;
    letter-spacing: .12em;
    border-bottom: 1px solid var(--line);
  }
  .explorer .head .ico{
    display: inline-flex; gap: 4px;
    color: var(--mute);
  }
  .explorer .head .ico svg{ width: 14px; height: 14px }
  .explorer .head .ico svg:hover{ color: var(--ink) }

  .tree-scroll{ flex: 1; overflow-y: auto; padding: 6px 0 10px;
    font-family: "JetBrains Mono", monospace; font-size: 12.5px }
  .tree-scroll::-webkit-scrollbar{ width: 4px }
  .tree-scroll::-webkit-scrollbar-thumb{ background: var(--line-2); border-radius: 2px }
  .tree ul{ list-style: none; padding: 0; margin: 0 }
  .tree li{
    padding: 0;
    color: var(--ink-2);
    line-height: 1.5;
    position: relative;
  }
  .tree li > .name{
    display: flex; align-items: center; gap: 6px;
    padding: 3px 14px;
    cursor: default;
    border-radius: 0;
    transition: background .15s ease, color .15s ease;
  }
  .tree li > .name:hover{ background: var(--panel-2) }
  .tree li.folder > .name::before{
    content: "▸";
    color: var(--mute);
    font-size: 9px;
    width: 8px;
  }
  .tree li.folder.open > .name::before{ content: "▾" }
  .tree li.folder > .name .glyph{
    width: 14px; color: var(--warn); opacity: .65;
  }
  .tree li.file > .name::before{ content: ""; width: 8px }
  .tree li.file > .name .glyph{
    width: 14px; color: var(--ice); opacity: .8;
  }
  .tree li.file.modified > .name .glyph{ color: var(--warn) }
  .tree li.file.modified > .name::after{
    content: "M";
    margin-left: auto;
    font-size: 9.5px;
    color: var(--warn);
    font-weight: 600;
  }
  .tree li.file.added > .name::after{
    content: "A";
    margin-left: auto;
    font-size: 9.5px;
    color: var(--aurora);
    font-weight: 600;
  }
  .tree li.file.added > .name .glyph{ color: var(--aurora) }
  .tree li ul{ padding-left: 14px }
  .tree li.active > .name{
    background: oklch(0.83 0.10 220 / .12);
    color: var(--ink);
  }
  .tree li.reading > .name{
    background: oklch(0.78 0.16 155 / .15);
    color: var(--ink);
    animation: tree-pulse 1.2s ease-in-out infinite;
  }
  @keyframes tree-pulse{
    0%,100% { background: oklch(0.78 0.16 155 / .10) }
    50%     { background: oklch(0.78 0.16 155 / .22) }
  }

  /* === EDITOR ================================================ */
  .editor{
    display: flex; flex-direction: column;
    background: var(--panel);
    min-width: 0; min-height: 0;
    border-right: 1px solid var(--line);
  }
  .tabs{
    display: flex;
    background: var(--bg-2);
    border-bottom: 1px solid var(--line);
    flex-shrink: 0;
    overflow-x: auto;
  }
  .tabs::-webkit-scrollbar{ height: 0 }
  .tab{
    padding: 9px 16px 9px 14px;
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    color: var(--mute);
    border-right: 1px solid var(--line);
    display: flex; align-items: center; gap: 8px;
    cursor: default;
    position: relative;
    white-space: nowrap;
  }
  .tab .glyph{ color: var(--ice); opacity: .75 }
  .tab.active{ background: var(--panel); color: var(--ink) }
  .tab.active::before{
    content: ""; position: absolute;
    left: 0; right: 0; top: 0; height: 2px;
    background: var(--ice);
  }
  .tab.modified .x::before{ content: "●"; color: var(--warn); font-size: 9px }
  .tab .x{ width: 16px; height: 16px; display: grid; place-items: center; color: var(--mute) }
  .tab .x:hover{ color: var(--ink) }
  .tab.active .x::before{ content: "×" }
  .tab.modified.active .x::before{ content: "●"; color: var(--warn); font-size: 9px }

  .code-frame{
    flex: 1;
    display: grid;
    grid-template-columns: 1fr 48px;
    min-height: 0;
    overflow: hidden;
    background: var(--panel);
  }
  .code{
    overflow-y: auto;
    padding: 14px 0 14px 0;
    font-family: "JetBrains Mono", monospace;
    font-size: 13px;
    line-height: 1.75;
    color: var(--ink);
  }
  .code::-webkit-scrollbar{ width: 6px }
  .code::-webkit-scrollbar-thumb{ background: var(--line-2); border-radius: 3px }
  .code .line{
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 10px;
    padding: 0 16px 0 0;
    white-space: pre;
    position: relative;
  }
  .code .gut{
    color: var(--mute);
    text-align: right;
    user-select: none;
    font-size: 11px;
    opacity: .55;
    padding-top: 2px;
  }
  .code .line.cur .gut{ color: var(--ice); opacity: 1 }
  .code .line.cur{ background: oklch(0.83 0.10 220 / .04) }
  .code .line.hl-old{ background: oklch(0.70 0.18 25 / .14); position: relative }
  .code .line.hl-old::before{
    content: "−"; position: absolute; left: 4px; color: var(--red); font-weight: 600;
  }
  .code .line.removing{ animation: line-shatter .6s ease forwards }
  @keyframes line-shatter{
    0%   { opacity: 1; transform: translateX(0); filter: blur(0) }
    60%  { opacity: .35; transform: translateX(-4px); filter: blur(.4px) }
    100% { opacity: 0; transform: translateX(-14px); height: 0; padding: 0; line-height: 0; margin: 0 }
  }
  .code .line.ghost{
    background: oklch(0.78 0.16 155 / .07);
    color: oklch(0.85 0.05 155);
    opacity: 0;
    transform: translateY(-3px);
  }
  .code .line.ghost.show{
    opacity: 1; transform: translateY(0);
    transition: opacity .35s ease, transform .35s ease, background .5s ease;
  }
  .code .line.ghost::before{
    content: "+"; position: absolute; left: 4px;
    color: var(--aurora); font-weight: 600;
  }
  .code .line.ghost.committing{ background: oklch(0.78 0.16 155 / .26); animation: line-freeze .7s ease forwards }
  @keyframes line-freeze{
    0%   { background: oklch(0.78 0.16 155 / .25) }
    60%  { background: oklch(0.85 0.05 155 / .35) }
    100% { background: transparent; color: var(--ink) }
  }
  .code .line.ghost.committed{ background: transparent; color: var(--ink); opacity: 1 }
  .code .line.ghost.committed::before{ display: none }
  .code .caret{
    display: inline-block; width: 7px; height: 14px;
    background: var(--ice); vertical-align: -2px;
    margin: 0 1px;
    animation: caret-blink 1s steps(1) infinite;
  }
  @keyframes caret-blink{ 50%{ opacity: 0 } }

  .kw{ color: var(--magenta) }
  .ty{ color: var(--aurora-2) }
  .fn{ color: var(--ice) }
  .var{ color: var(--ink) }
  .str{ color: var(--aurora) }
  .com{ color: var(--mute); font-style: italic }
  .num{ color: var(--warn) }

  .profile{
    background: linear-gradient(180deg, var(--bg-2) 0%, oklch(0.10 0.04 235) 100%);
    border-left: 1px solid var(--line);
    position: relative;
    overflow: hidden;
  }
  .profile::before{
    content: "";
    position: absolute; inset: 0;
    background-image:
      linear-gradient(180deg, transparent 0%, transparent 24%, rgba(125,211,252,.04) 25%, transparent 26%, transparent 49%, rgba(125,211,252,.04) 50%, transparent 51%, transparent 74%, rgba(125,211,252,.04) 75%, transparent 76%);
    pointer-events: none;
  }
  .profile svg{ width: 100%; height: 100%; display: block; position: relative; z-index: 1 }
  .profile .peak{
    fill: oklch(0.83 0.10 220);
    filter: drop-shadow(0 0 3px oklch(0.83 0.10 220));
  }
  .profile .peak-fn{
    fill: oklch(0.78 0.16 155);
    filter: drop-shadow(0 0 3px oklch(0.78 0.16 155));
  }
  .profile .shimmer{
    animation: profile-shimmer 6s ease-in-out infinite;
  }
  @keyframes profile-shimmer{
    0%, 100% { opacity: .15 }
    50%      { opacity: .45 }
  }
  .profile .ax{ stroke: var(--line-2); stroke-width: .3 }
  .profile .indicator{
    position: absolute;
    right: 0; left: 0;
    height: 18px;
    pointer-events: none;
    top: 18%;
    transition: top .8s cubic-bezier(.2,.7,.2,1);
    z-index: 2;
  }
  .profile .indicator::before{
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at right center, oklch(0.83 0.10 220 / .45) 0%, transparent 70%);
  }
  .profile .indicator::after{
    content: "";
    position: absolute;
    right: 0; top: 50%;
    width: 100%; height: 1px;
    background: linear-gradient(90deg, transparent 30%, oklch(0.78 0.16 155) 100%);
    transform: translateY(-.5px);
    box-shadow: 0 0 4px oklch(0.78 0.16 155);
  }
  .profile .indicator .label{
    position: absolute;
    right: 4px; top: 50%;
    transform: translateY(-50%);
    font-family: "JetBrains Mono", monospace;
    font-size: 9px;
    color: var(--aurora);
    letter-spacing: .05em;
    background: var(--bg-2);
    padding: 1px 4px;
    border-radius: 3px;
    border: 1px solid var(--line);
  }

  .kernel-log{
    flex-shrink: 0;
    border-top: 1px solid var(--line);
    padding: 6px 14px;
    background: var(--bg-2);
    font-family: "JetBrains Mono", monospace;
    font-size: 10.5px;
    color: var(--mute);
    line-height: 1.7;
    max-height: 78px;
    overflow-y: auto;
  }
  .kernel-log::-webkit-scrollbar{ width: 3px }
  .kernel-log::-webkit-scrollbar-thumb{ background: var(--line-2) }
  .kernel-log div{ opacity: 0; animation: log-in .25s ease forwards }
  @keyframes log-in{
    from{ opacity: 0; transform: translateX(-4px) }
    to  { opacity: 1; transform: translateX(0) }
  }
  .kernel-log .ts{ color: var(--ice); opacity: .6 }
  .kernel-log .ok{ color: var(--aurora) }

  /* === CHAT ================================================== */
  .chat{
    display: flex; flex-direction: column;
    background: var(--panel);
    min-width: 0; min-height: 0;
    border-right: 1px solid var(--line);
    position: relative;
  }
  .chat-head{
    display: flex; justify-content: space-between; align-items: center;
    padding: 9px 14px;
    border-bottom: 1px solid var(--line);
    background: var(--bg-2);
  }
  .chat-head .title{
    display: flex; align-items: center; gap: 10px;
    font-size: 13px;
    font-weight: 500;
    color: var(--ink);
  }
  .chat-head .aurora-mark{ width: 18px; height: 18px }
  .chat-head .aurora-mark svg{ width: 100%; height: 100%; overflow: visible }
  .chat-head .aurora-mark .w{ fill: none; stroke-width: 1.4; stroke-linecap: round }
  .chat-head .aurora-mark .w1{ stroke: var(--aurora) }
  .chat-head .aurora-mark .w2{ stroke: var(--ice); opacity: .8 }
  .chat-head .chat-actions{ display: flex; gap: 4px }
  .chat-head .chat-actions button{
    width: 26px; height: 26px;
    display: grid; place-items: center;
    border-radius: 5px;
    color: var(--mute);
    transition: color .15s, background .15s;
  }
  .chat-head .chat-actions button:hover{ color: var(--ink); background: var(--panel-2) }
  .chat-head .chat-actions svg{ width: 14px; height: 14px }

  .convo{
    flex: 1;
    overflow-y: auto;
    padding: 16px 14px;
    display: flex; flex-direction: column; gap: 16px;
  }
  .convo::-webkit-scrollbar{ width: 4px }
  .convo::-webkit-scrollbar-thumb{ background: var(--line-2) }

  .msg{
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 10px;
    animation: msg-in .35s cubic-bezier(.2,.7,.2,1);
  }
  @keyframes msg-in{
    from{ opacity: 0; transform: translateY(6px) }
    to  { opacity: 1; transform: translateY(0) }
  }
  .msg .avatar{
    width: 24px; height: 24px; border-radius: 5px;
    display: grid; place-items: center;
    font-family: "JetBrains Mono", monospace; font-size: 10.5px; font-weight: 600;
  }
  .msg.user .avatar{ background: var(--panel-2); color: var(--ink-2); border: 1px solid var(--line-2) }
  .msg.ai .avatar{ background: var(--bg-2); border: 1px solid var(--line); padding: 4px }
  .msg .avatar .aurora-mark{ width: 100%; height: 100%; display: block }
  .msg .avatar .aurora-mark svg{ width: 100%; height: 100% }
  .msg .avatar .aurora-mark .w{ fill: none; stroke-width: 1.4; stroke-linecap: round }
  .msg .avatar .aurora-mark .w1{ stroke: var(--aurora) }
  .msg .avatar .aurora-mark .w2{ stroke: var(--ice); opacity: .8 }
  .msg .meta{
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    color: var(--mute);
    text-transform: uppercase;
    letter-spacing: .08em;
    margin-bottom: 4px;
  }
  .msg .meta b{ color: var(--ink-2); font-weight: 500 }
  .msg .body{ font-size: 14px; line-height: 1.55; color: var(--ink) }
  .msg .body code{
    font-family: "JetBrains Mono", monospace; font-size: 12px;
    background: var(--panel-2); border: 1px solid var(--line);
    padding: 1px 6px; border-radius: 3px; color: var(--ice);
  }
  .tools{
    margin-top: 6px;
    border-left: 1px solid var(--line);
    padding: 4px 0 4px 12px;
    display: flex; flex-direction: column; gap: 4px;
  }
  .tools .step{
    font-family: "JetBrains Mono", monospace;
    font-size: 11.5px;
    color: var(--mute);
    line-height: 1.6;
    display: flex; align-items: center; gap: 8px;
  }
  .tools .step .glyph{ width: 10px; text-align: center }
  .tools .step.run .glyph{ color: var(--ice); animation: glyph-spin 1s linear infinite }
  .tools .step.done{ color: var(--ink-2) }
  .tools .step.done .glyph{ color: var(--aurora) }
  .tools .step.done .glyph::after{ content: "✓" }
  .tools .step.run .glyph::after{ content: "↻" }
  .tools .step.queue .glyph::after{ content: "·" }
  @keyframes glyph-spin{ to{ transform: rotate(360deg) } }

  /* === COMPOSER ============================================= */
  .composer{
    border-top: 1px solid var(--line);
    background: var(--bg-2);
    flex-shrink: 0;
    padding: 10px 12px 10px;
  }
  .attach-chips{
    display: flex; gap: 6px; flex-wrap: wrap;
    margin-bottom: 8px;
    min-height: 0;
  }
  .attach-chips:empty{ display: none }
  .chip{
    display: inline-flex; align-items: center;
    gap: 6px;
    padding: 4px 8px;
    background: var(--panel-2);
    border: 1px solid var(--line-2);
    border-radius: 4px;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    color: var(--ink-2);
  }
  .chip .ice{ color: var(--ice) }
  .chip .aur{ color: var(--aurora) }
  .chip .x{ color: var(--mute); cursor: pointer; padding: 0 2px }
  .chip .x:hover{ color: var(--ink) }

  .composer-input{
    background: var(--panel);
    border: 1px solid var(--line-2);
    border-radius: 8px;
    padding: 10px 12px;
    font-family: "JetBrains Mono", monospace;
    font-size: 12.5px;
    color: var(--ink);
    min-height: 56px;
    display: block;
    width: 100%;
    outline: none;
    resize: none;
    line-height: 1.55;
    transition: border-color .15s;
  }
  .composer-input:focus{ border-color: var(--ice) }
  .composer-input.empty::before{
    content: attr(data-placeholder);
    color: var(--mute);
    pointer-events: none;
  }
  .composer-input .caret{
    display: inline-block; width: 7px; height: 14px;
    background: var(--ice); vertical-align: -2px;
    margin-left: 2px;
    animation: caret-blink 1s steps(1) infinite;
  }

  .composer-bar{
    display: flex; justify-content: space-between;
    align-items: center;
    margin-top: 8px;
    gap: 6px;
    flex-wrap: wrap;
  }
  .composer-bar .left, .composer-bar .right{
    display: flex; align-items: center; gap: 4px;
    flex-wrap: wrap;
    min-width: 0;
  }
  .composer-bar .right{ justify-content: flex-end; flex: 1 }
  .cbtn{
    display: inline-flex; align-items: center; gap: 5px;
    height: 26px;
    padding: 0 8px;
    border-radius: 5px;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    color: var(--ink-2);
    border: 1px solid transparent;
    transition: background .12s, color .12s, border-color .12s;
    position: relative;
  }
  .cbtn:hover{
    background: var(--panel-2);
    color: var(--ink);
    border-color: var(--line-2);
  }
  .cbtn svg{ width: 13px; height: 13px; opacity: .85 }
  .cbtn small{ color: var(--mute); margin-left: 1px; font-size: 10px }
  .cbtn .ctx-meta{
    color: var(--mute);
    font-size: 10px;
    font-weight: 400;
    margin-left: 2px;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 110px;
    white-space: nowrap;
  }
  .cbtn.toggle.on{
    background: oklch(0.83 0.10 220 / .10);
    color: var(--ice);
    border-color: oklch(0.83 0.10 220 / .35);
  }
  .cbtn.toggle.on svg{ opacity: 1 }
  .cbtn.icon-only{ width: 26px; justify-content: center; padding: 0 }
  .cbtn.send{
    background: var(--ice);
    color: #06121d;
    font-weight: 600;
    border-color: transparent;
  }
  .cbtn.send:hover{ background: #fff; color: #06121d }
  .cbtn.send kbd{
    margin-right: 2px;
    color: rgba(6,18,29,.6);
    font-family: inherit;
  }

  /* dropdowns */
  .menu{
    position: absolute;
    bottom: calc(100% + 6px);
    left: 0;
    min-width: 200px;
    background: var(--panel);
    border: 1px solid var(--line-2);
    border-radius: 8px;
    padding: 4px;
    box-shadow: 0 18px 40px -10px rgba(0,0,0,.7);
    z-index: 30;
    display: none;
  }
  .cbtn.open .menu{ display: block }
  .menu .mi{
    display: grid;
    grid-template-columns: 14px 1fr auto;
    gap: 8px;
    align-items: center;
    padding: 7px 10px;
    border-radius: 5px;
    font-family: "JetBrains Mono", monospace;
    font-size: 11.5px;
    color: var(--ink-2);
    cursor: pointer;
    transition: background .12s, color .12s;
  }
  .menu .mi:hover{ background: var(--panel-2); color: var(--ink) }
  .menu .mi.on{ color: var(--ink) }
  .menu .mi.on::after{
    content: "✓";
    color: var(--ice);
    font-size: 11px;
  }
  .menu .mi .glyph{ color: var(--ice); opacity: .85 }
  .menu .mi small{ color: var(--mute); font-size: 10px; display: block; margin-top: 2px; letter-spacing: 0 }
  .menu .mi .meta{ font-size: 10px; color: var(--mute) }
  .menu .group-title{
    font-family: "JetBrains Mono", monospace;
    font-size: 9.5px;
    color: var(--mute);
    text-transform: uppercase;
    letter-spacing: .12em;
    padding: 6px 10px 4px;
    border-top: 1px solid var(--line);
    margin-top: 4px;
  }
  .menu .group-title:first-child{ border-top: none; margin-top: 0 }
  .menu.right-anchor{ left: auto; right: 0 }

  /* === HISTORY =============================================== */
  .history{
    background: var(--bg-2);
    display: flex; flex-direction: column;
    min-height: 0;
    overflow: hidden;
  }
  .history .head{
    display: flex; justify-content: space-between; align-items: center;
    padding: 10px 14px;
    font-family: "JetBrains Mono", monospace;
    font-size: 10.5px;
    color: var(--mute);
    text-transform: uppercase;
    letter-spacing: .12em;
    border-bottom: 1px solid var(--line);
  }
  .history .head .plus{ width: 20px; height: 20px; color: var(--mute) }
  .history .head .plus:hover{ color: var(--ice) }
  .history .head .plus svg{ width: 13px; height: 13px }
  .history-list{
    flex: 1; overflow-y: auto;
    padding: 4px 0 10px;
  }
  .history-list::-webkit-scrollbar{ width: 4px }
  .history-list::-webkit-scrollbar-thumb{ background: var(--line-2) }
  .h-item{
    display: block;
    padding: 9px 14px;
    border-left: 2px solid transparent;
    cursor: default;
    transition: background .15s;
  }
  .h-item:hover{ background: var(--panel-2) }
  .h-item.active{
    background: var(--panel-2);
    border-left-color: var(--ice);
  }
  .h-item .date{
    font-family: "JetBrains Mono", monospace;
    font-size: 9.5px;
    color: var(--mute);
    text-transform: uppercase;
    letter-spacing: .08em;
    margin-bottom: 4px;
  }
  .h-item .title{
    font-size: 12.5px;
    color: var(--ink);
    line-height: 1.4;
    margin-bottom: 4px;
  }
  .h-item .preview{
    font-size: 11px;
    color: var(--mute);
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .h-item .badge{
    display: inline-block;
    margin-top: 5px;
    font-family: "JetBrains Mono", monospace;
    font-size: 9px;
    color: var(--aurora);
    padding: 1px 6px;
    background: oklch(0.78 0.16 155 / .08);
    border-radius: 3px;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .history-section{
    padding: 8px 14px 4px;
    font-family: "JetBrains Mono", monospace;
    font-size: 9.5px;
    color: var(--mute);
    text-transform: uppercase;
    letter-spacing: .12em;
    border-bottom: 1px solid var(--line);
    margin-top: 4px;
  }

  /* === STATUSBAR ============================================= */
  .statusbar{
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 0 14px;
    background: var(--bg-2);
    border-top: 1px solid var(--line);
    font-family: "JetBrains Mono", monospace;
    font-size: 10.5px;
    color: var(--mute);
    overflow-x: auto;
    white-space: nowrap;
  }
  .statusbar::-webkit-scrollbar{ height: 0 }
  .statusbar .item{
    display: inline-flex; align-items: center;
    gap: 6px;
    height: 100%;
    padding: 0 6px;
  }
  .statusbar .item:hover{ background: var(--panel-2) }
  .statusbar .dot{
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--aurora);
    box-shadow: 0 0 6px var(--aurora);
  }
  .statusbar .num{ color: var(--ink) }
  .statusbar .spacer{ flex: 1 }
  .statusbar .ice{ color: var(--ice) }
  .statusbar .warn{ color: var(--warn) }

  /* === RESPONSIVE ============================================ */
  @media (max-width: 1380px){
    .frame{ grid-template-columns: 44px 220px 1fr 380px }
    .history{ display: none }
  }
  @media (max-width: 1240px){
    .cbtn .ctx-meta{ display: none }
  }
  @media (max-width: 1100px){
    .frame{ grid-template-columns: 44px 200px 1fr 340px }
  }
  @media (max-width: 880px){
    html, body{ overflow: auto }
    .ide{ position: relative; height: auto; min-height: calc(100vh - 28px); margin: 14px;
      grid-template-rows: 42px 30px 1fr auto }
    .frame{ grid-template-columns: 1fr; grid-template-rows: auto auto auto }
    .activity{ display: none }
    .explorer{ display: none }
    .editor{ min-height: 320px }
    .chat{ min-height: 480px; border-right: none }
    .topbar{ grid-template-columns: auto 1fr auto }
    .topbar-center{ display: none }
    .topbar .user .email{ display: none }
    .topbar .user .quota{ display: none }
    .crumb-row{ font-size: 10px }
    .crumb-row .branch{ display: none }
    .user-menu{ width: 280px }
  }
</style>
</head>
<body>

<!-- ============ BACKDROPS ============ -->
<div class="bg-topo" aria-hidden="true">
  <svg viewBox="0 0 1200 1200" preserveAspectRatio="none">
    <g fill="none" stroke="oklch(0.62 0.13 235)" stroke-width="0.6">
      <path d="M0,200 C200,180 380,260 600,220 C820,180 1000,240 1200,200" />
      <path d="M0,260 C220,230 400,330 620,280 C840,240 1010,300 1200,260" />
      <path d="M0,320 C240,290 420,400 640,340 C860,290 1020,360 1200,320" />
      <path d="M0,380 C260,350 440,460 660,400 C880,340 1030,420 1200,380" />
      <path d="M0,440 C220,410 410,520 640,460 C870,400 1040,480 1200,440" />
      <path d="M0,540 C260,510 420,620 660,560 C900,500 1050,580 1200,540" />
      <path d="M0,620 C240,590 430,700 650,640 C870,580 1050,660 1200,620" />
      <path d="M0,720 C260,690 420,800 660,740 C900,680 1050,760 1200,720" />
      <path d="M0,820 C240,790 430,900 650,840 C870,780 1050,860 1200,820" />
      <path d="M0,920 C260,890 420,1000 660,940 C900,880 1050,960 1200,920" />
      <path d="M0,1020 C240,990 430,1100 650,1040 C870,980 1050,1060 1200,1020" />
    </g>
    <g fill="none" stroke="oklch(0.78 0.16 155)" stroke-width="0.4" opacity=".5">
      <path d="M0,100 C260,70 460,180 700,120 C940,60 1080,140 1200,100" />
      <path d="M0,170 C260,140 460,250 700,190 C940,130 1080,210 1200,170" />
    </g>
  </svg>
</div>
<div class="bg-aurora" aria-hidden="true">
  <svg viewBox="0 0 1600 600" preserveAspectRatio="none">
    <defs>
      <linearGradient id="aur-a" x1="0" x2="0" y1="0" y2="1">
        <stop offset="0%"   stop-color="oklch(0.78 0.16 155)" stop-opacity=".5"/>
        <stop offset="100%" stop-color="oklch(0.78 0.16 155)" stop-opacity="0"/>
      </linearGradient>
      <linearGradient id="aur-b" x1="0" x2="0" y1="0" y2="1">
        <stop offset="0%"   stop-color="oklch(0.62 0.13 235)" stop-opacity=".4"/>
        <stop offset="100%" stop-color="oklch(0.62 0.13 235)" stop-opacity="0"/>
      </linearGradient>
      <filter id="aur-blur"><feGaussianBlur stdDeviation="48"/></filter>
    </defs>
    <g filter="url(#aur-blur)">
      <path fill="url(#aur-a)">
        <animate attributeName="d" dur="22s" repeatCount="indefinite"
          values="
            M0,180 C320,90 620,260 920,140 C1180,40 1400,180 1600,120 L1600,0 L0,0 Z;
            M0,140 C300,260 620,100 940,220 C1240,320 1380,140 1600,220 L1600,0 L0,0 Z;
            M0,180 C320,90 620,260 920,140 C1180,40 1400,180 1600,120 L1600,0 L0,0 Z"/>
      </path>
      <path fill="url(#aur-b)" opacity="0.85">
        <animate attributeName="d" dur="30s" repeatCount="indefinite"
          values="
            M0,260 C260,180 580,360 880,240 C1180,140 1380,260 1600,200 L1600,0 L0,0 Z;
            M0,220 C300,340 600,180 920,300 C1220,400 1380,240 1600,320 L1600,0 L0,0 Z;
            M0,260 C260,180 580,360 880,240 C1180,140 1380,260 1600,200 L1600,0 L0,0 Z"/>
      </path>
    </g>
  </svg>
</div>
<div class="bg-noise" aria-hidden="true"></div>

<main class="ide" data-screen-label="01 IDE">

  <!-- ============ TOPBAR ============ -->
  <header class="topbar">
    <div class="logo">
      <span class="mark">
        <svg viewBox="0 0 26 26" fill="none">
          <path d="M13 1 L25 13 L13 25 L1 13 Z" stroke="oklch(0.83 0.10 220)" stroke-width="1.2" stroke-opacity=".4"/>
          <path d="M13 4 L22 13 L13 22 L4 13 Z" fill="oklch(0.83 0.10 220)" fill-opacity=".18"/>
          <path d="M13 7 L19 13 L13 19 L7 13 Z" fill="oklch(0.83 0.10 220)"/>
        </svg>
      </span>
      <span><b>Alaska</b><span class="dot">-AI</span></span>
    </div>

    <div class="topbar-center" id="topbar-center">
      <button class="top-tab" data-menu="file">Файл
        <div class="menu-dd">
          <div class="mdd-item" data-act="new-file"><span>Новый файл</span><span class="kbd">⌘N</span></div>
          <div class="mdd-item"><span>Новое окно</span><span class="kbd">⇧⌘N</span></div>
          <div class="mdd-item"><span>Открыть…</span><span class="kbd">⌘O</span></div>
          <div class="mdd-item"><span>Открыть последние</span><span class="mdd-arrow">›</span></div>
          <div class="mdd-sep"></div>
          <div class="mdd-item"><span>Сохранить</span><span class="kbd">⌘S</span></div>
          <div class="mdd-item"><span>Сохранить как…</span><span class="kbd">⇧⌘S</span></div>
          <div class="mdd-item"><span>Сохранить всё</span><span class="kbd">⌥⌘S</span></div>
          <div class="mdd-sep"></div>
          <div class="mdd-item"><span>Закрыть редактор</span><span class="kbd">⌘W</span></div>
          <div class="mdd-item"><span>Закрыть папку</span><span class="kbd">⌘K F</span></div>
          <div class="mdd-sep"></div>
          <div class="mdd-item danger" data-act="signout"><span>Выйти из аккаунта</span><span class="kbd">⌘⇧Q</span></div>
        </div>
      </button>
      <button class="top-tab" data-menu="edit">Правка
        <div class="menu-dd">
          <div class="mdd-item"><span>Отменить</span><span class="kbd">⌘Z</span></div>
          <div class="mdd-item"><span>Повторить</span><span class="kbd">⌘⇧Z</span></div>
          <div class="mdd-sep"></div>
          <div class="mdd-item"><span>Вырезать</span><span class="kbd">⌘X</span></div>
          <div class="mdd-item"><span>Копировать</span><span class="kbd">⌘C</span></div>
          <div class="mdd-item"><span>Вставить</span><span class="kbd">⌘V</span></div>
          <div class="mdd-sep"></div>
          <div class="mdd-item"><span>Найти</span><span class="kbd">⌘F</span></div>
          <div class="mdd-item"><span>Заменить</span><span class="kbd">⌥⌘F</span></div>
          <div class="mdd-item" data-act="go-search"><span>Найти в файлах</span><span class="kbd">⇧⌘F</span></div>
        </div>
      </button>
      <button class="top-tab" data-menu="selection">Выделение
        <div class="menu-dd">
          <div class="mdd-item"><span>Выделить всё</span><span class="kbd">⌘A</span></div>
          <div class="mdd-item"><span>Выделить строку</span><span class="kbd">⌘L</span></div>
          <div class="mdd-item"><span>Расширить</span><span class="kbd">⌃⇧→</span></div>
          <div class="mdd-sep"></div>
          <div class="mdd-item"><span>Курсор сверху</span><span class="kbd">⌥⌘↑</span></div>
          <div class="mdd-item"><span>Курсор снизу</span><span class="kbd">⌥⌘↓</span></div>
          <div class="mdd-item"><span>Все вхождения</span><span class="kbd">⌘⇧L</span></div>
          <div class="mdd-sep"></div>
          <div class="mdd-item"><span>Колоночное</span><span class="kbd">⌥ click</span></div>
        </div>
      </button>
      <button class="top-tab" data-menu="view">Вид
        <div class="menu-dd">
          <div class="mdd-item"><span>Палитра команд</span><span class="kbd">⇧⌘P</span></div>
          <div class="mdd-item"><span>Открыть вид…</span><span class="mdd-arrow">›</span></div>
          <div class="mdd-sep"></div>
          <div class="mdd-item"><span>Боковая панель</span><span class="kbd">⌘B</span></div>
          <div class="mdd-item"><span>Чат Alaska</span><span class="kbd">⌘I</span></div>
          <div class="mdd-item"><span>Терминал</span><span class="kbd">⌃`</span></div>
          <div class="mdd-item"><span>История чатов</span><span class="kbd">⌃⌘H</span></div>
          <div class="mdd-sep"></div>
          <div class="mdd-item"><span>Полный экран</span><span class="kbd">⌃⌘F</span></div>
          <div class="mdd-item"><span>Zen режим</span><span class="kbd">⌘K Z</span></div>
        </div>
      </button>
      <button class="top-tab" data-menu="go">Перейти
        <div class="menu-dd">
          <div class="mdd-item"><span>К файлу…</span><span class="kbd">⌘P</span></div>
          <div class="mdd-item"><span>К строке…</span><span class="kbd">⌃G</span></div>
          <div class="mdd-item"><span>К символу</span><span class="kbd">⌘⇧O</span></div>
          <div class="mdd-sep"></div>
          <div class="mdd-item"><span>К определению</span><span class="kbd">F12</span></div>
          <div class="mdd-item"><span>К ссылке</span><span class="kbd">⇧F12</span></div>
          <div class="mdd-item"><span>Назад</span><span class="kbd">⌃−</span></div>
          <div class="mdd-item"><span>Вперёд</span><span class="kbd">⌃⇧−</span></div>
        </div>
      </button>
      <button class="top-tab" data-menu="terminal">Терминал
        <div class="menu-dd">
          <div class="mdd-item"><span>Новый терминал</span><span class="kbd">⌃`</span></div>
          <div class="mdd-item"><span>Разделить терминал</span><span class="kbd">⌃⇧`</span></div>
          <div class="mdd-sep"></div>
          <div class="mdd-item"><span>Запустить задачу…</span><span class="kbd">⌘⇧B</span></div>
          <div class="mdd-item"><span>Агент ALaska</span><span class="kbd">⌘I</span></div>
          <div class="mdd-item"><span>Очистить терминал</span><span class="kbd">⌃K</span></div>
        </div>
      </button>
      <button class="top-tab" data-menu="help">Помощь
        <div class="menu-dd">
          <div class="mdd-item"><span>Документация</span><span class="mdd-arrow">↗</span></div>
          <div class="mdd-item"><span>Горячие клавиши</span><span class="kbd">⌘K ⌘S</span></div>
          <div class="mdd-item"><span>Changelog</span></div>
          <div class="mdd-item"><span>Сообщить об ошибке</span><span class="mdd-arrow">↗</span></div>
          <div class="mdd-sep"></div>
          <div class="mdd-item"><span>О Alaska AI</span></div>
        </div>
      </button>
    </div>

    <div class="user">
      <span class="quota" title="План Pro · сброс 15 мая"><span class="dot-aur"></span>Pro · <b>$4.80 / $12</b></span>
      <button class="user-trigger" id="user-trigger" aria-label="Профиль">
        <span class="email">alex@warehouse.dev</span>
        <span class="avatar">A</span>
        <span class="caret">▾</span>
      </button>
      <div class="user-menu" id="user-menu">
        <div class="um-header">
          <div class="um-avatar">A</div>
          <div class="um-id">
            <div class="um-name">Alex Petrov</div>
            <div class="um-email">alex@warehouse.dev</div>
          </div>
        </div>
        <div class="um-plan">
          <div class="um-row"><span>тариф</span><span class="ice">Pro</span></div>
          <div class="um-row"><span>кредиты</span><span><b>$4.80</b> / $12</span></div>
          <div class="um-bar"><i style="width:40%"></i></div>
          <div class="um-row sub"><span>сброс</span><span>через 15 дней · 15 мая</span></div>
        </div>
        <div class="um-section">
          <a class="um-item" data-um="dashboard">
            <span class="glyph">▤</span>
            <span>Открыть Dashboard</span>
            <span class="ext">↗</span>
          </a>
          <a class="um-item" data-um="plan">
            <span class="glyph">⊕</span>
            <span>Сменить тариф</span>
            <span class="meta">⌘,</span>
          </a>
          <a class="um-item" data-um="settings">
            <span class="glyph">⦾</span>
            <span>Настройки IDE</span>
            <span class="meta">⌘,</span>
          </a>
          <a class="um-item" data-um="keys">
            <span class="glyph">⊸</span>
            <span>API-ключи</span>
          </a>
        </div>
        <div class="um-section">
          <a class="um-item" data-um="switch">
            <span class="glyph">↻</span>
            <span>Сменить аккаунт</span>
          </a>
          <a class="um-item danger" data-um="signout" id="um-signout">
            <span class="glyph">⇦</span>
            <span>Выйти из IDE</span>
            <span class="meta">⌘⇧Q</span>
          </a>
        </div>
        <div class="um-foot">Alaska-AI · v0.1.5 · macOS arm64</div>
      </div>
    </div>
  </header>

  <!-- ============ CRUMB ROW ============ -->
