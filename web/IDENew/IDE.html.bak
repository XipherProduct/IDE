          <path d="M8 10v8a4 4 0 0 0 8 0v-8M8 10a4 4 0 0 1 8 0M8 10H4M16 10h4M5 14h3M16 14h3M5 18h3M16 18h3"/>
        </svg>
      </button>
      <button class="act" data-panel="ext" title="Extensions">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v4a3 3 0 0 0 3 3h0a3 3 0 0 1-3-3v-4z"/>
        </svg>
      </button>
      <button class="act" data-panel="chat" title="Alaska Chat">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M21 12c0 4.4-4 8-9 8-1.4 0-2.8-.3-4-.8L4 21l1.8-3.2C4.7 16.3 4 14.2 4 12c0-4.4 4-8 9-8s8 3.6 8 8z"/>
        </svg>
      </button>
      <div class="act-spacer"></div>
      <button class="act compass" title="Coordinates">
        <svg viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.4" opacity=".4"/>
          <path d="M12,4 L13.5,12 L12,20 L10.5,12 Z" fill="oklch(0.78 0.13 80)"/>
          <path d="M12,4 L13.5,12 L10.5,12 Z" fill="oklch(0.70 0.18 25)"/>
        </svg>
      </button>
      <button class="act" title="Settings">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <circle cx="12" cy="12" r="3"/>
          <path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 0 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 0 1 0-4h.1a1.7 1.7 0 0 0 1.5-1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3h0a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5h0a1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8v0a1.7 1.7 0 0 0 1.5 1H21a2 2 0 0 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/>
        </svg>
      </button>
    </nav>

    <!-- ===== EXPLORER ===== -->
    <aside class="explorer">
      <div class="panel active" data-panel="files">
      <div class="head">
        <span>ALASKA-AI</span>
        <span class="ico">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M8 3v10M3 8h10"/></svg>
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M4 5l3 3-3 3M9 12h3"/></svg>
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M3 8a5 5 0 1 1 10 0 5 5 0 0 1-10 0M8 5v3l2 2"/></svg>
        </span>
      </div>
      <div class="tree-scroll">
        <div class="tree">
          <ul>
            <li class="folder open">
              <div class="name"><span class="glyph">▣</span>src</div>
              <ul>
                <li class="folder open">
                  <div class="name"><span class="glyph">▣</span>warehouse</div>
                  <ul>
                    <li class="file"><div class="name"><span class="glyph">‹›</span>index.ts</div></li>
                    <li class="file active modified" data-file="moveItem"><div class="name"><span class="glyph">‹›</span>moveItem.ts</div></li>
                    <li class="file" data-file="types"><div class="name"><span class="glyph">‹›</span>types.ts</div></li>
                    <li class="file" data-file="locks"><div class="name"><span class="glyph">‹›</span>locks.ts</div></li>
                    <li class="file" data-file="errors"><div class="name"><span class="glyph">‹›</span>errors.ts</div></li>
                  </ul>
                </li>
                <li class="folder">
                  <div class="name"><span class="glyph">▣</span>api</div>
                </li>
                <li class="folder">
                  <div class="name"><span class="glyph">▣</span>routes</div>
                </li>
                <li class="folder">
                  <div class="name"><span class="glyph">▣</span>db</div>
                </li>
                <li class="file"><div class="name"><span class="glyph">‹›</span>app.ts</div></li>
              </ul>
            </li>
            <li class="folder">
              <div class="name"><span class="glyph">▣</span>tests</div>
            </li>
            <li class="folder">
              <div class="name"><span class="glyph">▣</span>scripts</div>
            </li>
            <li class="file added"><div class="name"><span class="glyph">‹›</span>.alaskarules</div></li>
            <li class="file"><div class="name"><span class="glyph">{ }</span>package.json</div></li>
            <li class="file"><div class="name"><span class="glyph">md</span>README.md</div></li>
          </ul>
        </div>
      </div>
    </div>

